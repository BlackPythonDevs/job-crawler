# Required: Apprise API notify endpoint (configure destinations on the Apprise side)
APPRISE_URL=http://apprise:8000/notify/job-crawler

# OpenAI-compatible LLM endpoint (Ollama, vLLM, OpenRouter, OpenAI, etc.)
LLM_BASE_URL=http://localhost:11434/v1
MODEL_NAME=ministral-3
LLM_API_KEY=not-needed

# Valkey/Redis dedup store
VALKEY_URL=valkey://localhost:6379/0
JOB_TTL_SECONDS=7776000

# Polling cadence (seconds). Default 4h.
POLL_INTERVAL_SECONDS=14400

# Path to TOML board config
JOB_CRAWLER_CONFIG=/app/config.toml

# Status API
API_HOST=0.0.0.0
API_PORT=8080

# Log file inside the container (rotates at 10 MB x 3)
LOG_FILE=/var/log/job-crawler/job-crawler.log
